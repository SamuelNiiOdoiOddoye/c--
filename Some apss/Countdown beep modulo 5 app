#include <iostream>

int main(){

    //a program to accept N and print till 1, print multiples of 5 as beep

    std::cout << "Type In the number";
    int N;
    cin >> N;

    for(int i = 0 ; N <= 1 ; i++){
        N = N -1 ;
        std::cout << "N" << endl; 
    }

    while( N%5 == 0){

        std::cout << "BEEP" << endl ;
    }
    return 0;
}